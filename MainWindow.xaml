<Window x:Class="Tasky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tasky"
        Title="Tasky" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowDrop="True" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        Width="800" Height="160" Left="0" Top="0">

    <Grid x:Name="Root">
        <!-- The dock itself: a pill at the bottom, icons grow upwards out of it -->
        <Grid x:Name="DockHost" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DockSlide"/>
            </Grid.RenderTransform>
            <Border x:Name="Pill" VerticalAlignment="Bottom" CornerRadius="18"
                    BorderBrush="{DynamicResource T.Stroke}" BorderThickness="1"
                    MouseRightButtonUp="OnDockRightClick">
                <Border.Background>
                    <SolidColorBrush x:Name="PillBrush" Color="#202020" Opacity="0.7"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35"/>
                </Border.Effect>
            </Border>

            <StackPanel x:Name="DockRow" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0">
                <!-- Start -->
                <Border x:Name="StartButton" Style="{StaticResource DockButton}" VerticalAlignment="Bottom"
                        ToolTipService.IsEnabled="False"
                        MouseLeftButtonUp="OnStartClick" MouseRightButtonUp="OnDockRightClick">
                    <Viewbox x:Name="StartIcon" Margin="12">
                        <Canvas Width="20" Height="20">
                            <Canvas.Resources>
                                <LinearGradientBrush x:Key="Logo" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4CC2FF" Offset="0"/>
                                    <GradientStop Color="#0078D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Canvas.Resources>
                            <Rectangle Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource Logo}"/>
                            <Rectangle Canvas.Left="10.6" Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource Logo}"/>
                            <Rectangle Canvas.Top="10.6" Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource Logo}"/>
                            <Rectangle Canvas.Left="10.6" Canvas.Top="10.6" Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource Logo}"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <Rectangle x:Name="SepLeft" Width="1" Fill="{DynamicResource T.Sep}" VerticalAlignment="Bottom" Margin="6,0"/>

                <!-- Apps -->
                <ItemsControl x:Name="Apps" VerticalAlignment="Bottom"
                              MouseMove="OnAppsMouseMove" MouseLeave="OnAppsMouseLeave"
                              PreviewMouseUp="OnAppsMouseUp" PreviewMouseLeftButtonDown="OnAppsMouseDown"
                              LostMouseCapture="OnAppsLostCapture">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DockItem}">
                            <!-- Near-transparent fill keeps the whole slot clickable on a layered window -->
                            <Grid x:Name="Slot" Width="{Binding SlotWidth}" Height="{Binding SlotHeight}" Opacity="{Binding Presence}"
                                  HorizontalAlignment="{Binding EdgeH}" VerticalAlignment="{Binding EdgeV}" Background="#01FFFFFF">
                                <Border x:Name="Hover" Margin="{Binding HoverMargin}" CornerRadius="10" Background="Transparent"/>
                                <Image Source="{Binding Icon}" Width="{Binding Size}" Height="{Binding Size}"
                                       HorizontalAlignment="{Binding EdgeH}" VerticalAlignment="{Binding EdgeV}" Margin="{Binding IconMargin}"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border x:Name="Indicator" Width="5" Height="4" CornerRadius="2"
                                        HorizontalAlignment="{Binding EdgeH}" VerticalAlignment="{Binding EdgeV}" Margin="{Binding IndicatorMargin}"
                                        LayoutTransform="{Binding IndicatorTransform}"
                                        Background="{DynamicResource T.Indicator}" Opacity="0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                    <Setter TargetName="Hover" Property="Background" Value="{DynamicResource T.ItemHover}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Indicator" Property="Width" Value="16"/>
                                    <Setter TargetName="Indicator" Property="Background" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAttention}" Value="True">
                                    <Setter TargetName="Indicator" Property="Width" Value="16"/>
                                    <Setter TargetName="Indicator" Property="Background" Value="#FFB900"/>
                                </DataTrigger>
                                <!-- An icon on its way out can't be clicked -->
                                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                                    <Setter TargetName="Slot" Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Running apps that don't fit on the screen, in a menu -->
                <Border x:Name="OverflowButton" Style="{StaticResource DockButton}" Visibility="Collapsed"
                        MouseLeftButtonUp="OnOverflowClick" MouseRightButtonUp="OnOverflowClick">
                    <TextBlock x:Name="OverflowGlyph" Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="{DynamicResource T.Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Rectangle x:Name="SepRight" Width="1" Fill="{DynamicResource T.Sep}" VerticalAlignment="Bottom" Margin="6,0"/>

                <!-- System tray: an overflow chevron, then the icons pinned to the dock -->
                <StackPanel x:Name="TrayArea" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border x:Name="TrayMore" Style="{StaticResource DockButton}"
                            MouseLeftButtonUp="OnTrayMoreClick" MouseRightButtonUp="OnDockRightClick">
                        <TextBlock x:Name="TrayMoreGlyph" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{DynamicResource T.Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ItemsControl x:Name="TrayPinned">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DockButton}" Width="{DynamicResource TrayItemWidth}"
                                        Height="{DynamicResource TrayItemHeight}"
                                        MouseDown="OnTrayMouseDown" MouseUp="OnTrayMouseUp" MouseMove="OnTrayMouseMove"
                                        MouseEnter="OnTrayMouseEnter" MouseLeave="OnTrayMouseLeave">
                                    <Image Source="{Binding Icon}" Width="{DynamicResource TrayIcon}" Height="{DynamicResource TrayIcon}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Status capsule: Quick Settings (wifi, volume, battery) and the clock, grouped like a
                     status bar so the right end reads as one tidy unit -->
                <Border x:Name="StatusCapsule" VerticalAlignment="Bottom" Background="{DynamicResource T.CapsuleBg}"
                        BorderBrush="{DynamicResource T.CapsuleStroke}" BorderThickness="1">
                    <StackPanel x:Name="StatusRow" Orientation="Horizontal">
                        <Border x:Name="QuickSettings" Style="{StaticResource DockButton}"
                                MouseLeftButtonUp="OnQuickSettingsClick" MouseRightButtonUp="OnDockRightClick"
                                MouseEnter="OnStatusMouseEnter" MouseLeave="OnStatusMouseLeave">
                            <StackPanel x:Name="QuickGlyphs" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                        <Setter Property="Foreground" Value="{DynamicResource T.Glyph}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </StackPanel.Resources>
                                <!-- Wi-Fi bars are drawn over a faint full-wifi glyph, as Windows does -->
                                <Grid>
                                    <TextBlock x:Name="WifiBack" Text="&#xE701;" Opacity="0.3"/>
                                    <TextBlock x:Name="WifiGlyph" Text="&#xE701;"/>
                                </Grid>
                                <TextBlock x:Name="VolumeGlyph" Text="&#xE767;"/>
                                <TextBlock x:Name="BatteryGlyph" Text="&#xE83F;"/>
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StatusDivider" Fill="{DynamicResource T.Divider}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border x:Name="Clock" Style="{StaticResource DockButton}"
                                MouseLeftButtonUp="OnClockClick" MouseRightButtonUp="OnDockRightClick">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ClockTime" Foreground="{DynamicResource T.Fg}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="ClockDate" Foreground="{DynamicResource T.Sub}" HorizontalAlignment="Right" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Dock settings -->
                <Border x:Name="SettingsButton" Style="{StaticResource DockButton}" VerticalAlignment="Bottom"
                        MouseLeftButtonUp="OnSettingsClick" MouseRightButtonUp="OnDockRightClick">
                    <TextBlock x:Name="SettingsGlyph" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{DynamicResource T.Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Every tray icon; pin one to keep it on the dock -->
        <Popup x:Name="TrayPopup" PlacementTarget="{Binding ElementName=TrayMore}" Placement="Top" StaysOpen="True"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="OnTrayPopupOpened" Closed="OnTrayPopupClosed">
            <Border Margin="10" Padding="6" CornerRadius="8" Background="{DynamicResource T.MenuBg}" BorderBrush="{DynamicResource T.MenuStroke}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel Width="206">
                    <TextBlock Text="Tray icons" Foreground="{DynamicResource T.Sub}" FontSize="12" Margin="6,2,6,6"
                               FontFamily="{StaticResource UiFont}"/>
                    <ItemsControl x:Name="TrayAll">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Slot" Width="38" Height="38" ToolTip="{Binding Title}">
                                    <Border Style="{StaticResource DockButton}"
                                            MouseDown="OnTrayMouseDown" MouseUp="OnTrayMouseUp" MouseMove="OnTrayMouseMove"
                                            MouseEnter="OnTrayMouseEnter" MouseLeave="OnTrayMouseLeave">
                                        <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <!-- Pin toggle: always shown when pinned, on hover otherwise -->
                                    <Border x:Name="Pin" Width="16" Height="16" CornerRadius="8" Background="#01FFFFFF"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden"
                                            ToolTip="Pin to dock"
                                            MouseLeftButtonDown="OnTrayPinDown" MouseLeftButtonUp="OnTrayPinClick">
                                        <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="{DynamicResource T.PinGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Slot" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Pin" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter TargetName="Pin" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Pin" Property="ToolTip" Value="Unpin from dock"/>
                                        <Setter TargetName="PinGlyph" Property="Text" Value="&#xE841;"/>
                                        <Setter TargetName="PinGlyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TrayEmpty" Text="No tray icons yet. Apps add theirs as they start."
                               Foreground="{DynamicResource T.Faint}" FontSize="12" TextWrapping="Wrap" Margin="6,4"
                               FontFamily="{StaticResource UiFont}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Floating name label over the hovered icon -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="NameLabel" Visibility="Collapsed" CornerRadius="6" Padding="9,4"
                    Background="{DynamicResource T.LabelBg}" BorderBrush="{DynamicResource T.MenuStroke}" BorderThickness="1">
                <TextBlock x:Name="NameLabelText" Foreground="{DynamicResource T.Fg}" FontSize="12"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
