<Window x:Class="Tasky.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tasky"
        Title="Tasky settings" Width="940" Height="700" MinWidth="720" MinHeight="460"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource S.Window}" Foreground="{DynamicResource S.Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- ===== Scrollbar: thin overlay thumb, no arrows, widens on hover ===== -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" Width="3" CornerRadius="1.5" Background="{DynamicResource S.Scroll}"
                                                        HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Width" Value="6"/>
                                                        <Setter TargetName="Bar" Property="CornerRadius" Value="3"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Width" Value="6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Sidebar navigation: a radio button per page ===== -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Foreground" Value="{DynamicResource S.Fg}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="38" CornerRadius="5" Background="Transparent">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource S.Accent}" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource S.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource S.NavSelected}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Setting card ===== -->
        <Style TargetType="local:SettingRow">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingRow">
                        <Border Background="{DynamicResource S.Card}" BorderBrush="{DynamicResource S.CardStroke}"
                                BorderThickness="1" CornerRadius="6" Padding="18,0,18,0" MinHeight="68">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="66"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding Icon}" FontFamily="{StaticResource Icons}" FontSize="18"
                                           Width="20" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,12,20,12">
                                    <TextBlock Text="{TemplateBinding Title}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource S.Sub}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ContentPresenter x:Name="Body" Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="{x:Null}">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Wide" Value="True">
                                <Setter TargetName="Body" Property="Grid.Row" Value="1"/>
                                <Setter TargetName="Body" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="Body" Property="Grid.ColumnSpan" Value="2"/>
                                <Setter TargetName="Body" Property="Margin" Value="0,0,0,14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>
        <!-- The number beside a slider -->
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource S.Sub}"/>
        </Style>

        <!-- ===== Slider ===== -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource S.Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource S.SliderRest}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRest}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20" Background="Transparent">
                                                    <Ellipse Fill="{DynamicResource S.Thumb}" Stroke="{DynamicResource S.CardStroke}" StrokeThickness="1"/>
                                                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource S.Accent}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Width" Value="13"/>
                                                        <Setter TargetName="Dot" Property="Height" Value="13"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Dot" Property="Width" Value="8"/>
                                                        <Setter TargetName="Dot" Property="Height" Value="8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Toggle switch with an On/Off label, like Windows Settings ===== -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="State" Text="Off" Width="28" Margin="0,0,12,0" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource S.ToggleStroke}" Background="{DynamicResource S.ToggleOff}">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource S.ToggleStroke}"
                                         HorizontalAlignment="Left" Margin="4,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="State" Property="Text" Value="On"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource S.Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource S.Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource S.OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14"/>
                                <Setter TargetName="Knob" Property="Height" Value="14"/>
                                <Setter TargetName="Knob" Property="Margin" Value="3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Radio button, for lists of choices ===== -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource S.Fg}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource S.ToggleStroke}" StrokeThickness="1" Fill="{DynamicResource S.ToggleOff}"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource S.OnAccent}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource S.Accent}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource S.Accent}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Segmented control: a row of radio buttons in one pill ===== -->
        <Style x:Key="Segments" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource S.SegmentsBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource S.CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource S.Sub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="4" Padding="14,5" MinWidth="64" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource S.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource S.SegmentOn}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource S.CardStroke}"/>
                                <Setter Property="Foreground" Value="{DynamicResource S.Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Button ===== -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource S.Fg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Padding="16,6" MinWidth="110" Background="{DynamicResource S.Button}"
                                BorderBrush="{DynamicResource S.CardStroke}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource S.ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Margin="12,14,8,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,2,0,22">
                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource S.Accent}">
                    <Border Width="22" Height="7" CornerRadius="3.5" Background="{DynamicResource S.OnAccent}"
                            VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tasky" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="SidebarVersion" FontSize="12" Foreground="{DynamicResource S.Sub}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <RadioButton x:Name="NavAppearance" Content="Appearance" Tag="&#xE771;" Style="{StaticResource NavItem}"/>
                <RadioButton x:Name="NavDock" Content="Size &amp; position" Tag="&#xE740;" Style="{StaticResource NavItem}"/>
                <RadioButton x:Name="NavBehavior" Content="Behavior" Tag="&#xE945;" Style="{StaticResource NavItem}"/>
                <RadioButton x:Name="NavSystem" Content="System" Tag="&#xE770;" Style="{StaticResource NavItem}"/>
                <RadioButton x:Name="NavAbout" Content="About" Tag="&#xE946;" Style="{StaticResource NavItem}"/>
            </StackPanel>
        </DockPanel>

        <!-- Pages -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Visible" Focusable="False">
            <Grid Margin="28,22,36,28" MaxWidth="1000">

                <!-- Appearance -->
                <StackPanel x:Name="PageAppearance">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>

                    <local:SettingRow Icon="&#xE790;" Title="Theme" Description="Colours of the dock, its menus and this window.">
                        <Border Style="{StaticResource Segments}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Windows" Style="{StaticResource Segment}"/>
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Style="{StaticResource Segment}"/>
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Style="{StaticResource Segment}"/>
                            </StackPanel>
                        </Border>
                    </local:SettingRow>

                    <TextBlock Text="Dock background" Style="{StaticResource GroupTitle}"/>
                    <local:SettingRow Icon="&#xE8B9;" Title="Blur behind the dock" Description="Frosted glass, like the Windows taskbar.">
                        <CheckBox x:Name="Blur" Style="{StaticResource ToggleSwitch}"/>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE706;" Title="Background opacity" Description="How solid the dock's background is.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="OpacityValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="BackgroundOpacity" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow x:Name="RoundnessRow" Icon="&#xE739;" Title="Corner roundness">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RoundnessValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="Roundness" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>

                    <TextBlock Text="Details" Style="{StaticResource GroupTitle}"/>
                    <local:SettingRow Icon="&#xE823;" Title="Clock size" Description="Text size of the time and date.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClockSizeValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="ClockSize" Minimum="10" Maximum="22" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE916;" Title="Animation speed" Description="Magnification, sliding and bouncing.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SpeedValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="AnimationSpeed" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>

                    <Button x:Name="Reset" Content="Reset look to defaults" Style="{StaticResource SubtleButton}"
                            HorizontalAlignment="Left" Margin="0,18,0,0" Click="OnReset"/>
                </StackPanel>

                <!-- Size & position -->
                <StackPanel x:Name="PageDock" Visibility="Collapsed">
                    <TextBlock Text="Size &amp; position" Style="{StaticResource PageTitle}"/>

                    <local:SettingRow Icon="&#xE740;" Title="Icon size" Description="The dock shrinks them further if it runs out of room.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="IconSizeValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="IconSize" Minimum="28" Maximum="80" SmallChange="2" LargeChange="8"
                                    TickFrequency="2" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE76F;" Title="Space between icons">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SpacingValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="Spacing" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE8A3;" Title="Magnify icons on hover" Description="Icons grow as the mouse passes over them.">
                        <CheckBox x:Name="Magnify" Style="{StaticResource ToggleSwitch}"/>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE71E;" Title="Magnification" Description="How big the icon under the mouse gets.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MagnifyValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="MagnifyScale" Minimum="1.1" Maximum="2.2" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>

                    <TextBlock Text="Position" Style="{StaticResource GroupTitle}"/>
                    <local:SettingRow Icon="&#xE7F4;" Title="Screen edge" Description="Where the dock sits.">
                        <Border Style="{StaticResource Segments}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EdgeBottom" GroupName="Edge" Content="Bottom" Style="{StaticResource Segment}"/>
                                <RadioButton x:Name="EdgeTop" GroupName="Edge" Content="Top" Style="{StaticResource Segment}"/>
                                <RadioButton x:Name="EdgeLeft" GroupName="Edge" Content="Left" Style="{StaticResource Segment}"/>
                                <RadioButton x:Name="EdgeRight" GroupName="Edge" Content="Right" Style="{StaticResource Segment}"/>
                            </StackPanel>
                        </Border>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE7C4;" Title="Distance from the screen edge">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="GapValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="EdgeGap" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE7F8;" Title="Display" Description="The screen the dock is shown on." Wide="True">
                        <StackPanel x:Name="MonitorChoices"/>
                    </local:SettingRow>
                </StackPanel>

                <!-- Behavior -->
                <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                    <TextBlock Text="Behavior" Style="{StaticResource PageTitle}"/>

                    <local:SettingRow Icon="&#xE8A7;" Title="Dock and windows" Description="What happens when a window reaches the dock." Wide="True">
                        <StackPanel>
                            <RadioButton x:Name="ModeReserve" GroupName="Mode" Style="{StaticResource Choice}">
                                <StackPanel>
                                    <TextBlock Text="Keep windows clear of the dock"/>
                                    <TextBlock Text="Maximized windows stop where the dock starts." FontSize="12" Foreground="{DynamicResource S.Sub}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeAutoHide" GroupName="Mode" Style="{StaticResource Choice}">
                                <StackPanel>
                                    <TextBlock Text="Hide when a window overlaps"/>
                                    <TextBlock Text="Push the mouse against the screen edge, or press the Windows key, to bring it back."
                                               FontSize="12" Foreground="{DynamicResource S.Sub}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeAlways" GroupName="Mode" Content="Always show over windows" Style="{StaticResource Choice}"/>
                        </StackPanel>
                    </local:SettingRow>

                    <TextBlock Text="Auto-hide" Style="{StaticResource GroupTitle}"/>
                    <local:SettingRow Icon="&#xE7B3;" Title="Reveal delay" Description="Stops the dock popping up when you only brush the screen edge.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RevealValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="RevealDelay" Minimum="0" Maximum="800" TickFrequency="50" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xED1A;" Title="Hide delay" Description="Keeps the dock up for a moment after the mouse leaves it.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HideValue" Style="{StaticResource Value}"/>
                            <Slider x:Name="HideDelay" Minimum="0" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE765;" Title="Keyboard shortcut" Description="Ctrl + Alt + D brings up the dock.">
                        <CheckBox x:Name="ShowHotkey" Style="{StaticResource ToggleSwitch}"/>
                    </local:SettingRow>
                </StackPanel>

                <!-- System -->
                <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                    <TextBlock Text="System" Style="{StaticResource PageTitle}"/>

                    <local:SettingRow Icon="&#xE712;" Title="Tray icons" Description="Show the notification-area icons in the dock.">
                        <CheckBox x:Name="ShowTray" Style="{StaticResource ToggleSwitch}"/>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE73F;" Title="Hide the Windows taskbar" Description="Let the dock take its place. It comes back when Tasky closes.">
                        <CheckBox x:Name="HideTaskbar" Style="{StaticResource ToggleSwitch}"/>
                    </local:SettingRow>

                    <TextBlock Text="Startup" Style="{StaticResource GroupTitle}"/>
                    <local:SettingRow Icon="&#xE7E8;" Title="Start with Windows" Description="Open Tasky when you sign in.">
                        <CheckBox x:Name="AutoStart" Style="{StaticResource ToggleSwitch}"/>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE71D;" Title="Show Tasky in the Start menu" Description="Find it by searching for Tasky.">
                        <CheckBox x:Name="StartMenu" Style="{StaticResource ToggleSwitch}"/>
                    </local:SettingRow>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource PageTitle}"/>

                    <Border Background="{DynamicResource S.Card}" BorderBrush="{DynamicResource S.CardStroke}" BorderThickness="1"
                            CornerRadius="6" Padding="20,18" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource S.Accent}">
                                <Border Width="32" Height="10" CornerRadius="5" Background="{DynamicResource S.OnAccent}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="A floating dock for Windows 11." Foreground="{DynamicResource S.Sub}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <local:SettingRow Icon="&#xE774;" Title="Project on GitHub" Description="Source code, releases and issues.">
                        <Button Content="Open" Style="{StaticResource SubtleButton}" Click="OnGitHub"/>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE8B7;" Title="Data folder" Description="Settings, pinned apps and the log.">
                        <Button Content="Open" Style="{StaticResource SubtleButton}" Click="OnDataFolder"/>
                    </local:SettingRow>
                    <local:SettingRow Icon="&#xE8D7;" Title="License"
                                      Description="Free software under the GNU GPL v3. Tray support by ManagedShell (Apache 2.0)."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
